<?xml version="1.0" encoding="UTF-8"?>
<!--
  APEX FINTECH - web.config for IIS
  Fix: add MIME type .webp and .mp4 to IIS
-->
<configuration>
  <system.webServer>

    <!-- MIME TYPES -->
    <staticContent>
      <remove fileExtension=".webp" />
      <remove fileExtension=".mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".mp4"  mimeType="video/mp4" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
    </staticContent>

    <!-- Security: cho phép extension .webp đi qua request filtering -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".webp" />
          <remove fileExtension=".mp4" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
